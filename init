## ZSH config

if [[ -n "${ZSH_CONFIG_INIT_DONE:-}" ]]; then
  return
fi
# Not exported on purpose: this guard only needs to prevent re-sourcing
# init within the same process. Exporting it leaked into child shell
# processes (new tabs/panes inheriting environment), causing them to
# skip settings/secrets/antidote entirely — silently, with no error.
ZSH_CONFIG_INIT_DONE=1

typeset -U path PATH fpath FPATH

# Source file if it exists
function source_if_possible()
{
  if [ -r $1 ]; then
    source $1
  else
    print "$1 not found and cannot be sourced. Check ~/.config/zsh/init"
  fi
}

## Main sources
source_if_possible $ZSH_CONFIG/antidote
source_if_possible $ZSH_CONFIG/settings
source_if_possible $ZSH_CONFIG/runtime
source_if_possible $ZSH_CONFIG/secrets
source_if_possible $ZSH_CONFIG/alisa

# Erlang compile flags
export KERL_BUILD_DOCS="yes"
# export KERL_CONFIGURE_OPTIONS="--with-wx --with-wx-config=/opt/homebrew/bin/wx-config --without-javac --without-odbc"
export KERL_CONFIGURE_OPTIONS="--without-wx --without-javac --without-odbc"

